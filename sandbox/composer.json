{
    "name": "momokit/sandbox",
    "description": "Public MomoKit sandbox: a realistic mobile money API for trying the SDK without an account.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "momokit/core": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../packages/core",
            "options": {
                "symlink": true,
                "versions": {
                    "momokit/core": "0.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "MomoKit\\Sandbox\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MomoKit\\Sandbox\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S 127.0.0.1:8080 -t public public/index.php"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
